      "source": [
        "# COG Validation \u2014 Notebook Template\n",
        "\n",
        "Validate a COG with gdalinfo.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import json, subprocess\n",
        "p='data/input.tif'\n",
        "out=subprocess.check_output(['gdalinfo','-json',p])\n",
        "d=json.loads(out)\n",
        "print('driver', d.get('driverShortName'))\n",
        "print('size', d.get('size'))\n"
      ]
    }
  ],
